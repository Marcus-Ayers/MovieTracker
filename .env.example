# Copy this file to .env.local and fill it in. .env.local is never committed.

# Required. TMDB → https://www.themoviedb.org/settings/api
# Paste the long "API Read Access Token" (or the shorter "API Key" — either works).
TMDB_API_KEY=

# Optional. Adds IMDb / Rotten Tomatoes / Metacritic scores. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Leave empty locally: the app uses a built-in database stored in .data/.
# In production (Vercel), set this to your Neon Postgres connection string.
DATABASE_URL=

# Production only: protects the nightly job at /api/cron/daily. Vercel sends it automatically
# when set in the project's environment variables. Any long random string works.
CRON_SECRET=

# Sign-in (Clerk). From dashboard.clerk.com → your app → API keys.
# Development keys (pk_test_/sk_test_) work on *.vercel.app; production keys need your own domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
